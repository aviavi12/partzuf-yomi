APP_ENV=development
DEMO_MODE=true

# Database
DATABASE_URL=postgresql+asyncpg://partzuf:partzuf_dev@localhost:5432/partzuf_yomi

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram (create bot via @BotFather, get chat_id from /getUpdates)
# See README for detailed setup instructions
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dual channels: "הפרצוף היומי" (global news) + "הפרצוף הזמני" (Israel news)
# Leave empty to send both to TELEGRAM_CHAT_ID above
TELEGRAM_CHAT_ID_GLOBAL=
TELEGRAM_CHAT_ID_ISRAEL=

# AI Provider (openai, anthropic, or other)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# News Sources
AP_NEWS_URL=https://apnews.com/
ROTTER_SOURCE_URL=https://rotter.net/

# Scheduler
HOURLY_COLLECTION_ENABLED=true
DAILY_SYNTHESIS_HOUR=18
TIMEZONE=Asia/Jerusalem

# Logging
LOG_LEVEL=INFO
